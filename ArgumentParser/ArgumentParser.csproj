<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Packs an .xml beside each DLL, so consumers get the doc comments in IntelliSense.
         Also turns on CS1591 for any undocumented public member. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Nullable reference types need C# 8. netstandard2.0 would otherwise default to 7.3. -->
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- Source Link is built into the SDK. These make the symbols usable from the .snupkg:
         PublishRepositoryUrl writes the commit into the package, and EmbedUntrackedSources
         covers any generated file the debugger would otherwise fail to find. release.yml
         adds ContinuousIntegrationBuild=true so the CI build is deterministic. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- Checks at pack time that every target framework exposes the same public API.
         PackageValidationBaselineVersion is deliberately not set: 2.0.0 breaks the 1.x API
         on purpose. Set it to 2.0.0 once that version has shipped, so the next release is
         checked against it. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageId>ScottLilly.$(AssemblyName)</PackageId>
    <Title>Argument Parser</Title>
    <Authors>Scott Lilly</Authors>
    <Description>Package to easily parse individual parameters from a string, or array of strings, as is often done when running command line applications.</Description>
    <Copyright>Copyright (c) 2023-2026 Scott Lilly</Copyright>
    <RepositoryUrl>https://github.com/ScottLilly/ArgumentParser</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/ScottLilly/ArgumentParser</PackageProjectUrl>
    <PackageIcon>logo_128.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>arguments; parser; cli; command line</PackageTags>
    <Version>2.0.0</Version>
  </PropertyGroup>

  <!-- RELEASE_NOTES.md is the one place release notes live. The "## Version x.y.z" section
       matching <Version> is cut out of it here, and release.yml cuts the same section out
       for the GitHub Release, so the two cannot disagree. Backticks quote the text because
       it contains both kinds of quotation mark. -->
  <PropertyGroup>
    <ReleaseNotesText>$([System.IO.File]::ReadAllText("$(MSBuildThisFileDirectory)../RELEASE_NOTES.md"))</ReleaseNotesText>
    <ReleaseNotesText>$([System.Text.RegularExpressions.Regex]::Replace(`$(ReleaseNotesText)`, `(?s)^.*?## Version $(Version)\s*`, ``))</ReleaseNotesText>
    <ReleaseNotesText>$([System.Text.RegularExpressions.Regex]::Replace(`$(ReleaseNotesText)`, `(?s)\s*## Version .*$`, ``))</ReleaseNotesText>
    <PackageReleaseNotes>$(ReleaseNotesText)</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Include rather than Update: multi-targeting packs from the outer build, where the
         default None glob this used to amend is not populated, so Update matched nothing
         and the icon was left out of the package (NU5046). -->
    <None Include="logo_128.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
